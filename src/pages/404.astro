---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata" description="La pagina richiesta non esiste." noindex>
  <section class="section"><div class="wrap center nf">
    <p class="eyebrow">Errore 404</p>
    <h1>Pagina non trovata</h1>
    <p class="muted">La pagina che cerchi non esiste o è stata spostata.</p>
    <div class="btn-row"><a href="/" class="btn btn--primary">Vai alla home</a><a href="/contatti/" class="btn btn--outline">Contattaci</a></div>
  </div></section>
</Base>
<style>.nf { display: grid; justify-items: center; gap: 8px; }</style>
