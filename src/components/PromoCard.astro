---
import Icon from './Icon.astro';
import { temaNegozio, type NegozioId } from '../lib/data';
import type { CollectionEntry } from 'astro:content';
interface Props { promo: CollectionEntry<'promo'>; nomeGestore?: string }
const { promo, nomeGestore } = Astro.props;
const d = promo.data;
const tema = d.negozio === 'entrambi' ? 't-brand' : temaNegozio[d.negozio as NegozioId];
const dove = { formigine: 'TIM Formigine', maranello: 'Multibrand Maranello', entrambi: 'Entrambi i negozi' }[d.negozio];
const q = new URLSearchParams();
if (d.negozio !== 'entrambi') q.set('negozio', d.negozio);
if (d.esigenza) q.set('esigenza', d.esigenza);
q.set('promo', d.titolo);
const fmt = (s: string) => new Date(s + 'T00:00:00').toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
---
<article class:list={['promo card glow glow--soft', tema]} data-promo data-negozio={d.negozio} data-scadenza={d.scadenza || undefined}>
  {d.immagine && <img class="img" src={d.immagine} alt="" loading="lazy" />}
  <div class="meta">
    <span class="chip"><Icon name="store" size={14} />{dove}</span>
    {d.etichetta && <span class="chip chip--alt">{d.etichetta}</span>}
  </div>
  <h3>{d.titolo}</h3>
  {nomeGestore && <p class="gestore">{nomeGestore}</p>}
  <p class="desc">{d.descrizione}</p>
  {d.scadenza && <p class="scad"><Icon name="clock" size={16} />Valida fino al {fmt(d.scadenza)}</p>}
  {d.note && <p class="note">{d.note}</p>}
  <a class="link-arrow" href={`/contatti/?${q}#modulo`}>Richiedi info <Icon name="arrow" /></a>
</article>
<style>
  .promo { display: flex; flex-direction: column; gap: 10px; height: 100%; }
  .img { width: calc(100% + 2 * clamp(22px, 3vw, 32px)); max-width: none; margin: calc(-1 * clamp(22px, 3vw, 32px)) calc(-1 * clamp(22px, 3vw, 32px)) 6px; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius) var(--radius) 0 0; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip--alt { background: #fff4dc; color: #9a5b00; border-color: #f6d79a; }
  h3 { margin: 4px 0 0; }
  .gestore { font-weight: 700; color: var(--accent); margin: 0; font-size: .92rem; }
  .desc { color: var(--muted); margin: 0; }
  .scad { display: flex; gap: 6px; align-items: center; font-size: .88rem; font-weight: 600; margin: 0; }
  .note { font-size: .78rem; color: var(--muted); margin: 0; }
  .link-arrow { margin-top: auto; padding-top: 6px; }
</style>
